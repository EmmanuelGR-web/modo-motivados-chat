# Copiá este archivo como ".env" y completá tus valores.
# El archivo .env NO se sube al repositorio (está en .gitignore).
# En el hosting (Render) estos mismos valores se cargan en Environment.

# Contraseña de los expositores (usá una larga y difícil de adivinar)
ADMIN_PASSWORD=cambiar-por-una-clave-segura

# Nombres de los expositores, separados por coma.
# Quien escriba uno de estos nombres en el ingreso tendrá que poner la contraseña.
ADMIN_NAMES=Juan Pérez, María Gómez

# Opcionales
# EVENT_TITLE=Modo Motivados
# PORT=3000
